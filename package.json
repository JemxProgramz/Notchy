{
  "name": "notch-desktop",
  "version": "1.0.1",
  "description": "A lightweight Windows Dynamic Island utility",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Notch",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron .",
    "predev": "npm run build:native",
    "start": "electron .",
    "prestart": "npm run build:native",
    "check": "node scripts/check.cjs",
    "build": "electron-builder --win nsis portable",
    "prebuild": "npm run build:native",
    "build:dir": "electron-builder --dir",
    "prebuild:dir": "npm run build:native",
    "build:appx": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-appx.ps1",
    "prebuild:appx": "npm run build:native",
    "build:native": "node-gyp rebuild --directory src/native"
  },
  "dependencies": {
    "systeminformation": "^5.33.14"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "node-gyp": "^12.4.0"
  },
  "build": {
    "appId": "com.notch.desktop",
    "productName": "Notch",
    "asar": true,
    "extraResources": [
      {
        "from": "src/native/build/Release/wireless.node",
        "to": "wireless.node"
      },
      {
        "from": "src/native/build/Release/audio.node",
        "to": "audio.node"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "Build-test"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/notch.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notch"
    },
    "portable": {
      "artifactName": "Notch-${version}-portable.${ext}"
    }
  }
}
